# Per-machine secrets and config for this project.
#
# Copy this file to .env and fill in your values. NEVER commit .env.
# This .env.example IS committed — it's the contract that tells a
# fresh clone which env vars the utility module expects.
#
# Conventions (see .claude/conventions/sources.md):
#   - One prefix per source family (ATLAS_DB_*, IMF_*, FAOSTAT_*).
#   - Required vars use os.environ['X'] in the utility module (loud
#     KeyError on missing). Optional vars use .get() with defaults.
#   - Every var the utility module reads must appear here with a
#     placeholder value. Drift between this file and the code breaks
#     new-environment setup silently.
#
# Replace the example block below with your project's actual sources.

# ── Atlas of Economic Complexity (PostgreSQL) ─────────────────────
# Request credentials from Growth Lab / Harvard CID.
# ATLAS_DB_HOST=
# ATLAS_DB_NAME=
# ATLAS_DB_USER=
# ATLAS_DB_PASSWORD=
# ATLAS_DB_PORT=5432

# ── Public APIs (no key required) ─────────────────────────────────
# World Bank wbgapi / Data360, IMF SDMX, BIS SDMX, UN Comtrade public
# tier — no env vars needed. Documented in data_sources/ for posterity.

# ── Authed APIs (uncomment when used) ─────────────────────────────
# FAOSTAT_API_KEY=        # Obtain at https://fenixservices.fao.org/...
# COMTRADE_API_KEY=       # Obtain at https://comtradedeveloper.un.org/
